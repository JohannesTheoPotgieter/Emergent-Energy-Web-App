modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 80

[env]
# IMPORTANT: Do NOT add secret values to this file. .replit is committed to git.
# All secrets (SESSION_SECRET, JWT_SECRET, TOKEN_ENCRYPTION_KEY, AZURE_CLIENT_SECRET,
# DATABASE_URL, etc.) MUST be set via Replit Secrets Manager (Tools → Secrets) or
# Azure Key Vault. See docs/runbooks/secrets-rotation.md.
PORT = "5000"
PATH = "/home/runner/$REPL_SLUG/node_modules/.bin:${PATH}"
ENABLE_STARTUP_SCHEMA_REPAIR = "true"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm run build"]
run = ["sh", "-c", "npm run start"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
stack = "MOCKUP_JS"
mockupState = "FULLSTACK"
integrations = ["outlook:1.0.0"]

[userenv]

# AZURE_TENANT_ID and AZURE_CLIENT_ID are public OAuth identifiers, not secrets,
# and may safely live in git. AZURE_CLIENT_SECRET, QM_ACCESS_CODE, EPM_ACCESS_CODE,
# SESSION_SECRET, JWT_SECRET, TOKEN_ENCRYPTION_KEY and DATABASE_URL are secrets
# and MUST be set via Replit Secrets Manager — never here.
[userenv.shared]
AZURE_TENANT_ID = "d6319480-d61b-4f33-adac-b7bc740c2fad"
AZURE_CLIENT_ID = "d2fd99cb-d94c-44eb-93a2-a7456c314a32"
