# Deterministic QA/Test defaults for local and CI proof runs
SESSION_SECRET=test-session-secret
PORT=5000
API_URL=http://127.0.0.1:5000

# Keep startup deterministic in tests (no surprise mutation side-effects)
ENABLE_STARTUP_MAINTENANCE=false
ENABLE_STARTUP_SCHEMA_REPAIR=false
ENABLE_STARTUP_DATA_SEED=false
ENABLE_STARTUP_BACKFILL=false
ENABLE_STARTUP_SESSION_RESET=false
ENABLE_STARTUP_USER_SEED=false

# Optional: tighten release gate behavior
REQUIRE_CRITICAL_DEFECT_FILE=true
