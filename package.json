{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev:client": "vite dev --port 5000",
    "dev": "node script/with-node-env.cjs development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "start": "node script/with-node-env.cjs production node dist/index.cjs",
    "check": "tsc -p tsconfig.check.json && tsc -p tsconfig.client-check.json",
    "check:client": "tsc -p tsconfig.client-check.json",
    "ci:compile": "turbo run lint check build --cache-dir=.turbo && npm run test:permission-contracts",
    "db:push": "tsx scripts/db-ensure-schemas.ts && drizzle-kit push --force",
    "db:setup": "tsx scripts/db-ensure-schemas.ts && drizzle-kit push --force && ENABLE_STARTUP_SCHEMA_REPAIR=true ENABLE_STARTUP_DATA_SEED=true ENABLE_STARTUP_BACKFILL=true ENABLE_STARTUP_USER_SEED=true node script/with-node-env.cjs development tsx server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/drizzle-bootstrap.ts && drizzle-kit migrate && tsx scripts/db-verify-schema.ts --repair",
    "db:check": "tsx scripts/db-check-drift.ts",
    "db:status": "tsx scripts/db-status.ts",
    "db:verify-schema": "tsx scripts/db-verify-schema.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore:verify": "tsx scripts/verify-backup-restore.ts",
    "backup:selftest": "bash scripts/backup-restore-selftest.sh",
    "verify:finance": "tsx server/scripts/verify-all-projects-reconciliation.ts && tsx server/scripts/verify-cross-surface-finance.ts",
    "check:agent-docs": "tsx scripts/check-agent-docs.ts",
    "qa:role-audit": "tsx scripts/generate-role-permission-audit.ts",
    "reconcile:priority-links": "tsx scripts/reconcile-priority-links.ts",
    "report:qb-project-match": "tsx server/scripts/qb-project-match-report.ts",
    "test": "vitest run -c qa/vitest.config.ts --exclude 'qa/tests/api/**' --exclude 'qa/tests/e2e/**' --exclude 'qa/tests/integration/**'",
    "test:api": "tsx script/run-with-app.ts \"vitest run -c qa/vitest.config.ts --no-file-parallelism qa/tests/api\"",
    "test:smoke": "tsx script/run-with-app.ts \"playwright test -c qa/playwright.config.ts qa/tests/e2e/smoke.spec.ts\"",
    "test:smoke:install": "playwright install chromium",
    "test:smoke:headed": "tsx script/run-with-app.ts \"playwright test -c qa/playwright.config.ts qa/tests/e2e/smoke.spec.ts --headed\"",
    "test:routes": "tsx script/test-routes.ts",
    "qa:report": "tsx script/qa-report.ts",
    "test:route-proof": "vitest run -c qa/vitest.config.ts qa/tests/unit/route-proof.test.ts",
    "qa:route-smoke-report": "tsx script/route-smoke-report.ts",
    "release:gate": "tsx qa/release-gate.ts",
    "reconciliation:report": "tsx qa/generate-reconciliation-evidence.ts",
    "test:workflows": "tsx script/run-with-app.ts \"tsx script/test-workflows.ts\"",
    "test:db-api-readiness": "vitest run -c qa/vitest.config.ts qa/tests/unit/api-v2-business-flows.test.ts qa/tests/unit/api-v2-policy-and-validation.test.ts",
    "qa:full-proof": "npm run check && npm run test:api && npm run test:smoke && npm run test:routes && npm run test:workflows && npm run reconciliation:report && npm run release:gate",
    "test:coverage": "vitest run -c qa/vitest.config.ts --coverage",
    "drift:report": "tsx scripts/find-drift.ts",
    "encrypt-bank-details": "tsx scripts/encrypt-existing-bank-details.ts",
    "seed:test-users": "tsx scripts/seed-test-users.ts",
    "check:routes-migration": "tsx scripts/check-routes-migration.ts",
    "check:duplicate-routes": "tsx scripts/check-duplicate-routes.ts",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --cache --cache-location .eslintcache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:permission-contracts": "vitest run -c qa/vitest.config.ts qa/tests/unit/permissions-route-contract.test.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.6.0",
    "@azure/keyvault-secrets": "^4.9.0",
    "@azure/msal-node": "^5.0.5",
    "@fontsource/barlow": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@hookform/resolvers": "^3.10.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.60.5",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "bullmq": "^5.71.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "connect-pg-simple": "^10.0.0",
    "date-fns": "^3.6.0",
    "dompurify": "^3.3.3",
    "dotenv": "^17.3.1",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "^0.7.0",
    "exceljs": "^4.4.0",
    "express": "^5.0.1",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.545.0",
    "memorystore": "^1.6.7",
    "multer": "^2.0.2",
    "nanoid": "^5.1.7",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "winston": "^3.19.0",
    "wouter": "^3.3.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@replit/vite-plugin-cartographer": "^0.4.11",
    "@replit/vite-plugin-dev-banner": "^0.1.1",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.4",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.0",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/pdfkit": "^0.17.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^6.1.1",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "turbo": "^2.9.6",
    "typescript": "6.0.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.3"
  }
}
