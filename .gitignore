node_modules
dist
.DS_Store

# ── Turborepo task cache ─────────────────────────────────────
.turbo

# ── ESLint cache (content-hashed by input files) ─────────────
.eslintcache

# ── Environment & secrets (NEVER commit) ─────────────────────
# Secrets must live in Replit Secrets Manager or Azure Key Vault.
# See docs/runbooks/secrets-rotation.md for the rotation procedure.
.env
.env.*
!.env.example
!.env.test.example

# ── Build & framework artifacts ──────────────────────────────
server/public
vite.config.ts.*
*.tar.gz

# ── Runtime data (developer machine state, not source) ───────
uploads/

# ── Scratch dir (regenerated by one-off scripts; never source) ─
# e.g. script/backfill-work-items-external-ref.ts mkdirs tmp/ and
# writes its report there. Committing scratch files lets a stray
# syntax error in a probe script break lint for the whole repo.
tmp/
data/
!client/src/data/
server/data-seed/.migrated
server/.pd-seed-done
backups/

# Claude Code: share operational config (skills, commands, agents, hooks,
# settings.json) with the team. Keep per-developer overrides and caches local.
.claude/settings.local.json
.claude/cache/

# ── Logs (operational artifacts, never source) ───────────────
*.log
*.err.log
*.out.log

# ── QA artifacts & reports (regenerated on every test run) ──
qa/artifacts/
qa/reports/
**/.last-run.json
combined.log
error.log
login-request.log
smoke-log.txt
devserver.log
devserver.err.log
replit-debug.err.log
replit-debug.out.log
replid-dev.err.log
replid-dev.out.log
replit-startup-check.err.log
replit-startup-check.out.log
node20-dev.err.log
node20-dev.out.log

# QA test snapshots are intentional commits (under qa/artifacts/ and qa/reports/)
!qa/artifacts/*.log
!qa/reports/*.log

# ── Type-check artefacts ─────────────────────────────────────
tsc-all.txt
tsc-errors.txt
.cache/
.migrations-drift-check/
qa/reports/vitest-results.json

# -- Replit paste artefacts & DB dumps (never source) --
attached_assets/*.png
attached_assets/*.jpeg
attached_assets/*.jpg
attached_assets/*.zip
*.dump
