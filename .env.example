# ============================================================
# Emergent Energy Web App — Environment Variables
# ============================================================
# A curated reference of the environment variables that matter for running
# and operating the app. It is committed to git as documentation only.
# (Replit/CI-injected vars — REPLIT_*, REPL_*, PG*, CI, VITEST, TZ — and
# script-only vars — BACKUP_*, RESTORE_TARGET_DATABASE_URL, DRIFT_OUTPUT_PATH —
# are set by their environment/tooling and are intentionally not listed here.)
#
# DEVELOPMENT (zero-config):
#   You do NOT need a .env to run `npm run dev`. With no DATABASE_URL set the
#   app uses a local SQLite fallback, and with no integration creds it serves
#   mock connector data (see MOCK CONNECTORS below). Only create a .env if you
#   need Postgres or a real integration locally.
#
#   If you DO create a .env, copy this file and set ONLY the vars you need —
#   do NOT blindly uncomment DATABASE_URL/SESSION_SECRET/JWT_SECRET with the
#   placeholder values below, or you will force Postgres mode against a bogus
#   URL and break the zero-config path. .env is .gitignore'd — never commit it.
#
# STAGING / PRODUCTION (Replit):
#   Set every value via Tools → Secrets in the Replit workspace.
#   Do NOT add real values to .replit or any committed file.
#
# Rotation procedure:
#   See docs/runbooks/secrets-rotation.md
# ============================================================

# ── REQUIRED IN STAGING / PRODUCTION (optional in local dev) ─────────
# NOTE: all three are intentionally left COMMENTED. Leaving DATABASE_URL unset
# is what enables the zero-config SQLite dev fallback (server/db-config.ts falls
# back to SQLite only when DATABASE_URL is ABSENT). SESSION_SECRET/JWT_SECRET are
# enforced by server/bootstrap/env-guard.ts only in staging/production.

# PostgreSQL connection string. Uncomment + set to run against Postgres locally.
# On Replit's PostgreSQL module, PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE are
# auto-detected and DATABASE_URL is constructed automatically.
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Session encryption key (strong random string; required in staging/prod)
# Generate with: openssl rand -hex 32
# SESSION_SECRET=change-me-to-a-random-string

# JWT signing secret (strong random string; required in staging/prod)
# Generate with: openssl rand -hex 32
# JWT_SECRET=change-me-to-a-random-string

# ── OPTIONAL (have sensible defaults) ────────────────────────

# Server port (default: 5000)
PORT=5000

# Node environment: development | staging | production
NODE_ENV=development

# Force database mode: postgres | sqlite (auto-detected if omitted)
# DB_MODE=postgres

# ── STARTUP FLAGS (all default to false) ─────────────────────
# Set to "true" to enable on startup

# Master switch — enables all startup maintenance tasks
# ENABLE_STARTUP_MAINTENANCE=false

# Run drizzle-kit push to auto-sync schema on startup
ENABLE_STARTUP_SCHEMA_REPAIR=true

# Seed default data (templates, roles, etc.)
# ENABLE_STARTUP_DATA_SEED=false

# Run data backfills (assignee IDs, work items, etc.)
# ENABLE_STARTUP_BACKFILL=false

# Clear all sessions on startup (production only)
# ENABLE_STARTUP_SESSION_RESET=false

# Seed default users
# ENABLE_STARTUP_USER_SEED=false

# ── MICROSOFT / AZURE INTEGRATION (optional) ─────────────────
# Required only for Microsoft 365 auth, SharePoint, and Outlook sync.
# App will start and run core functionality without these.

# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# Expiry DATE (not a secret) of AZURE_CLIENT_SECRET, as YYYY-MM-DD. Set this
# when you rotate the secret — it drives the COO's 30/7-day expiry alerts and
# the Connection Health countdown so the secret never lapses silently.
# AZURE_CLIENT_SECRET_EXPIRES_ON=2026-12-01

# ── SHAREPOINT APP-ONLY ACCESS (preferred for SharePoint reads + auto-import)
# A tenant-owned Azure app with app-only Microsoft Graph *Application*
# permissions — Sites.Read.All + Files.Read.All (add the *.ReadWrite.All
# variants only if app-only writes are later wired) — admin-consented. When
# all three are set, the app acquires its OWN Graph token and no longer
# depends on the Replit connector's consented scopes (fixes the Test
# Connection "missing_scope" failure). May reuse the AZURE_* app above
# (just add the Application permission + admin consent to it) or, preferred
# for least privilege, a dedicated app. Absent → falls back to the Replit
# connector unchanged. See docs/microsoft-integrations.md.
# SHAREPOINT_TENANT_ID=your-tenant-id
# SHAREPOINT_CLIENT_ID=your-app-client-id
# SHAREPOINT_CLIENT_SECRET=your-app-client-secret
# Expiry DATE (not a secret) of SHAREPOINT_CLIENT_SECRET, as YYYY-MM-DD. Set on
# each rotation — drives the SharePoint secret-expiry alerts + countdown.
# SHAREPOINT_CLIENT_SECRET_EXPIRES_ON=2026-12-01

# Token encryption key for Microsoft token-at-rest protection (32-byte key)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ── APPLICATION ACCESS CODES (optional) ──────────────────────

# Quality Manager access code
# QM_ACCESS_CODE=

# Engineering PM access code
# EPM_ACCESS_CODE=

# Passwords used to seed the COO_ADMIN / CEO_ADMIN role credentials on first
# run (min 12 chars). IMPORTANT: the code reads these TWO vars — SEED_ADMIN_PASSWORD
# is NOT read. If either is unset the seeder falls back to the hardcoded default
# "emergent2026" (see server/role-auth-routes.ts) — always set both before the
# first deployment, or you ship with a known default admin password.
# SEED_COO_ADMIN_PASSWORD=
# SEED_CEO_ADMIN_PASSWORD=

# ── DEBUG FLAGS (optional) ────────────────────────────────────

# AUTH_DEBUG=false
# LOCAL_DEV_MODE=false
# ADMIN_MIGRATION_MODE=false
# TR_DEFAULT_YEAR=2026

# ── MOCK CONNECTORS (local QA) ────────────────────────────────
# Default: auto-on when NODE_ENV != production AND no creds configured.
#   USE_MOCK_CONNECTORS=true   → force fixture data even if creds present
#   USE_MOCK_CONNECTORS=false  → force real API (useful for debugging live
#                                connector errors on a fresh clone)
# Prod is strictly NODE_ENV-gated — this flag has no effect there.
# See server/lib/connector-mode.ts for the decision table.
# USE_MOCK_CONNECTORS=

# ── SHAREPOINT AUTO-IMPORT (optional) ────────────────────────
# Phase 6 routes the scheduler through Smart Import v2 by default
# (writes smart_import_runs the UI shows). Set to "false" to fall
# back to the legacy v1 pipeline, which only writes metadata
# snapshots — leave unset in normal operation.
# AUTO_IMPORT_V2_ENABLED=false

# ── PIPEDRIVE CRM INTEGRATION (optional) ─────────────────────
# Required for syncing deals from Pipedrive into the Opportunities table.
# Get your API token from: Pipedrive → Settings → Personal preferences → API

# PIPEDRIVE_API_TOKEN=your-pipedrive-api-token

# ── QUICKBOOKS ONLINE INTEGRATION (optional) ─────────────────
# Required for the QuickBooks Online Accounting OAuth2 integration
# (invoices, customers, vendors, bills, P&L).
# Create the app at: https://developer.intuit.com/app/developer/dashboard
# Redirect URI must match the deployed callback exactly.

# QUICKBOOKS_CLIENT_ID=your-intuit-oauth2-client-id
# QUICKBOOKS_CLIENT_SECRET=your-intuit-oauth2-client-secret
# QUICKBOOKS_REDIRECT_URI=https://emergent-energy-dashboard.replit.app/api/quickbooks/callback

# ── WEBHOOK SECRETS (optional but strongly recommended) ───────
# Set these to protect the inbound webhook endpoints from unauthenticated
# third-party POST requests. Without them the endpoints accept all traffic.

# Microsoft Graph webhook: clientState value embedded in all Graph
# subscriptions. Requests whose clientState does not match this value
# are rejected with 401.
# Generate with: openssl rand -hex 32
# GRAPH_WEBHOOK_CLIENT_STATE=

# Read.ai webhook: shared secret sent as "Authorization: Bearer <secret>"
# Configure the same value in the Read.ai webhook settings page.
# Generate with: openssl rand -hex 32
# READAI_WEBHOOK_SECRET=

# ── REDIS (optional) ─────────────────────────────────────────
# When set, enables Redis-backed caching and BullMQ job queues.
# Without it the app falls back to in-memory equivalents (single-process,
# state lost on restart). Recommended for production.
# REDIS_URL=redis://localhost:6379

# ── AZURE KEY VAULT (production) ─────────────────────────────
# URI of the Azure Key Vault used to load production secrets at startup.
# Not required in development (secrets are read from .env directly).
# KEY_VAULT_URI=https://your-vault.vault.azure.net/

# ── ENDPOINT AUTH TOKENS (optional; protect internal feeds) ──
# Bearer/API-key tokens that gate internal reporting endpoints. If unset the
# corresponding endpoint is unauthenticated — set them in staging/prod.
# OPS_DASHBOARD_API_KEY=
# BI_FEED_TOKEN=

# ── SAFETY SWITCHES (leave OFF unless you know why) ──────────
# EXPOSE_ERROR_DETAIL=false      # true leaks error detail in API responses — never in prod
# ALLOW_DESTRUCTIVE_OPS=false    # gates destructive admin/ops routes
# COOKIE_SAMESITE=lax            # session cookie SameSite (lax|strict|none)

# ── STARTUP / RUNTIME MAINTENANCE (advanced) ─────────────────
# ENABLE_STARTUP_MIGRATIONS=false   # run drizzle migrations on boot (deploy uses db:migrate instead)
# ENABLE_RUNTIME_MAINTENANCE=false  # periodic in-process maintenance tasks
# STARTUP_ENABLE_PERIODIC_SYNC=false # background SharePoint/integration sync loop
# SCHEMA_AUTO_MIGRATE / SCHEMA_AUTO_REPAIR — internal boot schema-readiness flags

# ── FINANCE WATCHDOG (advanced; FROZEN surface — tuning only) ─
# FINANCE_WATCHDOG_INTERVAL_MS=       # interval for the finance drift watchdog
# FINANCE_INTEGRITY_INTERVAL_MS=      # interval for the finance integrity check
# FINANCE_MATERIAL_EDIT_THRESHOLD_ZAR= # ZAR delta that flags a "material" finance edit
# FYE_EXCLUSIONS_JSON=                # JSON list of FYE reconciliation exclusions
# QB_COS_ACCOUNT_NAME_PATTERNS=       # QuickBooks COS account-name match patterns

# ── SMART IMPORT v2 BEHAVIOUR FLAGS (advanced) ───────────────
# USE_THREE_WAY_MERGE / USE_SNAPSHOT_BASELINE / USE_MANUAL_OVERRIDES /
# IMPORT_FILE_ALWAYS_WINS — import conflict-resolution toggles. Defaults are the
# supported behaviour; change only with a clear reason (see docs/smart-import-v2-spec.md).
# TRACKER_FOLDER_PATH=              # override the SharePoint tracker folder path

# ── READ-ONLY DB (optional; for analytics/agent read access) ──
# CLAUDE_RO_DATABASE_URL= / CLAUDE_RO_PASSWORD=   # least-privilege read-only DB creds

# ── DB CONNECT TUNING (optional) ─────────────────────────────
# DB_CONNECT_TIMEOUT_MS= / DB_CONNECT_RETRY_ATTEMPTS= / DB_CONNECT_RETRY_BACKOFF_MS=

# NOTE (GitHub Actions secrets, not app env): PROD_DATABASE_URL and
# DEV_DATABASE_URL are consumed by CI workflows (db-backup + prod->dev sync),
# not by the app at runtime. Set them in the repo's GitHub Actions secrets.
