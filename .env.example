# ============================================================
# Emergent Energy Web App — Environment Variables
# ============================================================
# This file is the canonical list of every environment variable
# the app reads. It is committed to git as documentation only.
#
# DEVELOPMENT:
#   Copy this file to .env and fill in real values. .env is
#   .gitignore'd and must NEVER be committed.
#
# STAGING / PRODUCTION (Replit):
#   Set every value via Tools → Secrets in the Replit workspace.
#   Do NOT add real values to .replit or any committed file.
#
# Rotation procedure:
#   See docs/runbooks/secrets-rotation.md
# ============================================================

# ── REQUIRED ─────────────────────────────────────────────────

# PostgreSQL connection string (provided by Replit PostgreSQL module)
# If using Replit's PostgreSQL module, PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE
# are auto-detected and DATABASE_URL is constructed automatically.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Session encryption key (must be a strong random string in production)
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-string

# JWT signing secret (required — must be a strong random string)
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string

# ── OPTIONAL (have sensible defaults) ────────────────────────

# Server port (default: 5000)
PORT=5000

# Node environment: development | staging | production
NODE_ENV=development

# Force database mode: postgres | sqlite (auto-detected if omitted)
# DB_MODE=postgres

# ── STARTUP FLAGS (all default to false) ─────────────────────
# Set to "true" to enable on startup

# Master switch — enables all startup maintenance tasks
# ENABLE_STARTUP_MAINTENANCE=false

# Run drizzle-kit push to auto-sync schema on startup
ENABLE_STARTUP_SCHEMA_REPAIR=true

# Seed default data (templates, roles, etc.)
# ENABLE_STARTUP_DATA_SEED=false

# Run data backfills (assignee IDs, work items, etc.)
# ENABLE_STARTUP_BACKFILL=false

# Clear all sessions on startup (production only)
# ENABLE_STARTUP_SESSION_RESET=false

# Seed default users
# ENABLE_STARTUP_USER_SEED=false

# ── MICROSOFT / AZURE INTEGRATION (optional) ─────────────────
# Required only for Microsoft 365 auth, SharePoint, and Outlook sync.
# App will start and run core functionality without these.

# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# ── SHAREPOINT APP-ONLY ACCESS (preferred for SharePoint reads + auto-import)
# A tenant-owned Azure app with app-only Microsoft Graph *Application*
# permissions — Sites.Read.All + Files.Read.All (add the *.ReadWrite.All
# variants only if app-only writes are later wired) — admin-consented. When
# all three are set, the app acquires its OWN Graph token and no longer
# depends on the Replit connector's consented scopes (fixes the Test
# Connection "missing_scope" failure). May reuse the AZURE_* app above
# (just add the Application permission + admin consent to it) or, preferred
# for least privilege, a dedicated app. Absent → falls back to the Replit
# connector unchanged. See docs/microsoft-integrations.md.
# SHAREPOINT_TENANT_ID=your-tenant-id
# SHAREPOINT_CLIENT_ID=your-app-client-id
# SHAREPOINT_CLIENT_SECRET=your-app-client-secret

# Token encryption key for Microsoft token-at-rest protection (32-byte key)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ── APPLICATION ACCESS CODES (optional) ──────────────────────

# Quality Manager access code
# QM_ACCESS_CODE=

# Engineering PM access code
# EPM_ACCESS_CODE=

# Default password used for non-production role credential seeding (min 12 chars)
SEED_ADMIN_PASSWORD=

# ── DEBUG FLAGS (optional) ────────────────────────────────────

# AUTH_DEBUG=false
# LOCAL_DEV_MODE=false
# ADMIN_MIGRATION_MODE=false
# TR_DEFAULT_YEAR=2026

# ── MOCK CONNECTORS (local QA) ────────────────────────────────
# Default: auto-on when NODE_ENV != production AND no creds configured.
#   USE_MOCK_CONNECTORS=true   → force fixture data even if creds present
#   USE_MOCK_CONNECTORS=false  → force real API (useful for debugging live
#                                connector errors on a fresh clone)
# Prod is strictly NODE_ENV-gated — this flag has no effect there.
# See server/lib/connector-mode.ts for the decision table.
# USE_MOCK_CONNECTORS=

# ── SHAREPOINT AUTO-IMPORT (optional) ────────────────────────
# Phase 6 routes the scheduler through Smart Import v2 by default
# (writes smart_import_runs the UI shows). Set to "false" to fall
# back to the legacy v1 pipeline, which only writes metadata
# snapshots — leave unset in normal operation.
# AUTO_IMPORT_V2_ENABLED=false

# ── PIPEDRIVE CRM INTEGRATION (optional) ─────────────────────
# Required for syncing deals from Pipedrive into the Opportunities table.
# Get your API token from: Pipedrive → Settings → Personal preferences → API

# PIPEDRIVE_API_TOKEN=your-pipedrive-api-token

# ── QUICKBOOKS ONLINE INTEGRATION (optional) ─────────────────
# Required for the QuickBooks Online Accounting OAuth2 integration
# (invoices, customers, vendors, bills, P&L).
# Create the app at: https://developer.intuit.com/app/developer/dashboard
# Redirect URI must match the deployed callback exactly.

# QUICKBOOKS_CLIENT_ID=your-intuit-oauth2-client-id
# QUICKBOOKS_CLIENT_SECRET=your-intuit-oauth2-client-secret
# QUICKBOOKS_REDIRECT_URI=https://emergent-energy-dashboard.replit.app/api/quickbooks/callback

# ── WEBHOOK SECRETS (optional but strongly recommended) ───────
# Set these to protect the inbound webhook endpoints from unauthenticated
# third-party POST requests. Without them the endpoints accept all traffic.

# Microsoft Graph webhook: clientState value embedded in all Graph
# subscriptions. Requests whose clientState does not match this value
# are rejected with 401.
# Generate with: openssl rand -hex 32
# GRAPH_WEBHOOK_CLIENT_STATE=

# Read.ai webhook: shared secret sent as "Authorization: Bearer <secret>"
# Configure the same value in the Read.ai webhook settings page.
# Generate with: openssl rand -hex 32
# READAI_WEBHOOK_SECRET=

# ── REDIS (optional) ─────────────────────────────────────────
# When set, enables Redis-backed caching and BullMQ job queues.
# Without it the app falls back to in-memory equivalents (single-process,
# state lost on restart). Recommended for production.
# REDIS_URL=redis://localhost:6379

# ── AZURE KEY VAULT (production) ─────────────────────────────
# URI of the Azure Key Vault used to load production secrets at startup.
# Not required in development (secrets are read from .env directly).
# KEY_VAULT_URI=https://your-vault.vault.azure.net/
