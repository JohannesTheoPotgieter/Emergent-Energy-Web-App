{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./.cache/tsconfig.check.tsbuildinfo",
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "server/types/**/*.d.ts",
    "server/startup-modes.ts",
    "server/health-diagnostics.ts",
    "server/lib/api-error.ts",
    "server/startup-flags.ts",
    "server/canonical-boundaries.ts",
    "server/bootstrap/**/*.ts",
    "server/repositories/**/*.ts",
    "server/middleware/**/*.ts",
    "server/services/**/*.ts",
    "server/routes/**/*.ts",
    "server/api/**/*.ts",
    "server/jwt.ts",
    "server/db.ts",
    "server/auth-context.ts",
    "server/permission-middleware.ts",
    "server/audit-logger.ts",
    "server/routes.ts",
    "server/storage.ts",
    "server/index.ts",
    "server/scripts/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "scripts/_archive/**",
    "scripts/check-redirect-chains.ts"
  ]
}
